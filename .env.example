# Base URL of the MyMerchantPay API. Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=
# Dev-server only (read in vite.config.js, not exposed to the app).
# Comma-separated hostnames the dev server accepts, e.g. an ngrok domain.
ALLOWED_HOSTS=
# Dev-server port, also used for the Docker port mapping. Defaults to 5173.
HOST_PORT=
