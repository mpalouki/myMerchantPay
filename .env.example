# Base URL of the MyMerchantPay API. Leave empty to call the same origin (/api/...),
# which the dev server proxies to API_PROXY_TARGET. Set it only to bypass the proxy.
VITE_API_BASE_URL=
# Dev-server only: where /api/* is proxied. Defaults to http://localhost:8000
# (docker-compose.yml overrides it with http://host.docker.internal:8000).
API_PROXY_TARGET=
# Dev-server only (read in vite.config.js, not exposed to the app).
# Comma-separated hostnames the dev server accepts, e.g. an ngrok domain.
ALLOWED_HOSTS=
# Dev-server port, also used for the Docker port mapping. Defaults to 5173.
HOST_PORT=
